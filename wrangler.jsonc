{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "seed-to-vault",
  "compatibility_date": "2025-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "main": ".output/server/index.mjs",
  "ai": {
    "binding": "AI",
  },
  "assets": {
    "binding": "ASSETS",
    "directory": ".output/public",
  },
  "no_bundle": true,
  "rules": [
    {
      "type": "ESModule",
      "globs": ["**/*.mjs", "**/*.js"],
    },
  ],
}
